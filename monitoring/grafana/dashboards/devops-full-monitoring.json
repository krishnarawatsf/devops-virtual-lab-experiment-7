{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚀 Golden Signals: Application Performance & Traffic",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Throughput (RPS)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "Req/sec"
        }
      ]
    },
    {
      "id": 2,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "ms"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m])) * 100",
          "legendFormat": "Error %"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "app_active_sessions",
          "legendFormat": "Users"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "☸️ Kubernetes Pod & Node Infrastructure Metrics",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Pod CPU Utilization (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "pod_cpu_usage_percent",
          "legendFormat": "{{pod_name}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pod Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "pod_memory_usage_megabytes",
          "legendFormat": "{{pod_name}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Pod Restarts (CrashLoop Detection)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total",
          "legendFormat": "Restarts - {{pod_name}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Active Alertmanager Firing Alerts",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Active Alerts"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["vle-7", "kubernetes", "devops", "prometheus"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "VLE-7: Full DevOps Monitoring & CI/CD Dashboard",
  "uid": "vle7-devops-monitor"
}
